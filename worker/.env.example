# Model provider for Muse Spark Open: baseten (default) or fireworks. Audio input works on Baseten only.
PROVIDER=baseten

# Baseten Model APIs key (b10_...). Only valid with the meta-models/muse-spark-open-1026 slug.
BASETEN_API_KEY=

# Fireworks key (fw_...), used when PROVIDER=fireworks.
FIREWORKS_API_KEY=

# Meta Model API key (LLM_...), for Muse Voice Transcribe. Without it, reports say the audio wasn't checked.
# Every checked video's audio goes to Meta: on free credits, only check public Reels and your own test clips.
META_API_KEY=

# Shared with the web app: when set, checks need `Authorization: Bearer <token>`. Required on Vercel; unset locally.
WORKER_TOKEN=

# Dev only: 1 turns on POST /analyze-upload, which takes the video's bytes from the web dev server when there's
# no Blob token. Leave it unset anywhere the worker is reachable by others.
ALLOW_UPLOADS=
