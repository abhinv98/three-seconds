# Model provider for Muse Spark Open: baseten (default) or fireworks. Audio input works on Baseten only.
PROVIDER=baseten

# Baseten Model APIs key (b10_...). Only valid with the meta-models/muse-spark-open-1026 slug.
BASETEN_API_KEY=

# Fireworks key (fw_...), used when PROVIDER=fireworks.
FIREWORKS_API_KEY=
