# Vercel Blob read-write token. Set automatically when a Blob store (Public access) is connected
# to the Vercel project; pull it locally with `vercel env pull`. Without it, /check keeps videos in the
# browser tab in dev, and the dashboard's Check a Reel can't upload.
BLOB_READ_WRITE_TOKEN=

# Analysis worker base URL, e.g. http://127.0.0.1:8000. Leave empty for mock mode (sample report).
# In dev without a Blob token, /check sends the video's bytes to the worker through /api/analyze-local;
# start the worker with ALLOW_UPLOADS=1 for that.
WORKER_URL=

# Claude API key for the cave mini-game director (/api/cave). Server-only: never NEXT_PUBLIC_.
# Without it the cave still plays, on its built-in director.
ANTHROPIC_API_KEY=

# Dev only: other hostnames allowed to use the dev server, comma-separated (a LAN or Tailscale address),
# e.g. 192.168.0.195,100.96.70.25. Next blocks dev assets for anything but localhost otherwise.
DEV_ORIGINS=

# Accounts (Better Auth). A long random string that signs sessions: `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=

# Where the local account database lives. Defaults to web/.data (gitignored). Used only without TURSO_DATABASE_URL.
DATA_DIR=

# The Turso database for accounts, set by the Vercel Marketplace integration. Leave unset locally: dev uses DATA_DIR.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The secret the deployed worker requires on every check; the same value as the worker's WORKER_TOKEN.
# Leave it unset locally.
WORKER_TOKEN=
